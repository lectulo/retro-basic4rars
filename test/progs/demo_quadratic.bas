10 DATA 1,-3,2
20 DATA 1,2,1
30 DATA 1,1,1
40 FOR N=1 TO 3
50 READ A,B,C
60 PRINT "A=";A;" B=";B;" C=";C
70 LET D=B*B-4*A*C
80 IF D<0 THEN 140
90 IF D=0 THEN 160
100 LET X1=(-B+SQR(D))/(2*A)
110 LET X2=(-B-SQR(D))/(2*A)
120 PRINT "X1=";X1;" X2=";X2
130 GOTO 170
140 PRINT "NO REAL ROOTS"
150 GOTO 170
160 PRINT "X1=X2=";-B/(2*A)
170 NEXT N
180 END
